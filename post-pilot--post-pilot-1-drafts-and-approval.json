    {
      "parameters": {
        "jsCode": "const a = $('Parse Approval').first().json; const c = $input.first().json;\nlet ok = true, note;\nif (!a.allowed) { ok = false; note = 'Only approvers can decide.'; }\nelse if (!c.content_id) { ok = false; note = 'Content not found.'; }\nelse if (c.status !== 'pending_approval') { ok = false; note = 'Already ' + c.status + '.'; }\nelse if (a.action === 'approve' && c.scheduled_at <= $now.setZone('Africa/Cairo').toFormat('yyyy-MM-dd HH:mm')) note = 'Approved; the time has passed so it will post in the next 10 minutes.';\nconst status = { approve: 'approved', reject: 'rejected', edit: 'revise' }[a.action];\nreturn [{ json: { ...a, ok, status, note: note || (status === 'revise' ? 'Sent back for a new draft.' : status === 'approved' ? 'Approved ✅ will post at ' + c.scheduled_at : 'Rejected ❌') } }];"
      },
