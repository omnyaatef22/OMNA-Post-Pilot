    {
      "parameters": {
        "jsCode": "// New topics and topics sent back with feedback. Check the brief before spending an AI call.\nconst now = $now.setZone('Africa/Cairo').toFormat('yyyy-MM-dd HH:mm');\nconst out = [];\nfor (const { json: c } of $input.all()) {\n  if (!c.content_id || !['new', 'revise'].includes(c.status)) continue;\n  const p = []; const plats = String(c.platforms || '').split(',').map(s => s.trim()).filter(Boolean);\n  if (!plats.length || plats.some(x => !['facebook', 'linkedin'].includes(x))) p.push('platforms must be facebook and/or linkedin');\n  if (!['en', 'ar'].includes(c.language)) p.push('language must be en or ar');\n  if (!/^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$/.test(c.scheduled_at || '') || c.scheduled_at <= now) p.push('scheduled_at must be a future \"YYYY-MM-DD HH:mm\"');\n  if (String(c.topic || '').length < 10) p.push('topic too short');\n  if (Number(c.revisions || 0) >= 3) p.push('3 drafts rejected: a human should write this one');\n  out.push({ json: { ...c, plats, brief_problems: p } });\n}\nreturn out;"
      },
