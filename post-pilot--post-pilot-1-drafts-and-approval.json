    {
      "parameters": {
        "jsCode": "const rules = $('Read Rules').all().map(i => i.json); const tags = rules.filter(r => r.type === 'required_hashtag').map(r => r.value);\nconst banned = rules.filter(r => r.type === 'banned').map(r => r.value);\nreturn $input.all().map(({ json: c }) => ({ json: { ...c, prompt: 'Write social media posts for an Egyptian education/automation brand. Topic: ' + c.topic + '. Language: ' + (c.language === 'ar' ? 'Egyptian Arabic' : 'English') +\n  '. Platforms: ' + c.plats.join(', ') + '. Facebook: friendly, max 900 characters, 1 question to the audience. LinkedIn: professional, max 1300 characters, 3 short paragraphs. Include ' + tags.join(' ') + '. Never use: ' + banned.join(', ') +\n  (c.feedback ? '. The previous draft was rejected with this feedback, fix it: ' + c.feedback : '') + '. Return JSON only: {\"facebook\": \"\", \"linkedin\": \"\"} (empty string for platforms not requested).' } }));"
      },
      "id": "n458",
      "name": "Prepare Draft Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        -100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contents: [{ parts: [{ text: $json.prompt }].concat($json.b64 ? [{ inline_data: { mime_type: $json.mime, data: $json.b64 } }] : []) }], generationConfig: { responseMimeType: 'application/json', temperature: 0.1 } }) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "n459",
      "name": "AI Draft Posts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        -100
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    },
    {
      "parameters": {
        "jsCode": "// Platform limits, banned words and required hashtags are rules, not suggestions.\nconst rules = $('Read Rules').all().map(i => i.json); const val = t => rules.filter(r => r.type === t).map(r => r.value);\nconst lim = { facebook: Number(val('fb_max_chars')[0] || 2000), linkedin: Number(val('li_max_chars')[0] || 3000) };\nreturn $input.all().map((it, k) => {\n  const c = $('Prepare Draft Prompt').all()[k].json; let d; const p = [];\n  try { d = JSON.parse((it.json.candidates?.[0]?.content?.parts || []).map(x => x.text).join('')); } catch (e) { d = {}; p.push('AI returned invalid JSON'); }\n  const out = {};\n  for (const pl of c.plats) {\n    let t = String(d[pl] || '').trim(); if (!t) { p.push(pl + ' draft empty'); continue; }\n    for (const tag of val('required_hashtag')) if (!t.includes(tag)) t += ' ' + tag;\n    for (const b of val('banned')) if (t.toLowerCase().includes(b.toLowerCase())) p.push(pl + ' uses banned phrase \"' + b + '\"');\n    if (t.length > lim[pl]) p.push(pl + ' is ' + t.length + ' characters (max ' + lim[pl] + ')');\n    out[pl] = t;\n  }\n  return { json: { ...c, prompt: undefined, fb_text: out.facebook || '', li_text: out.linkedin || '', draft_problems: p, revisions: Number(c.revisions || 0) + 1 } };\n});"
      },
