    {
      "parameters": {
        "jsCode": "// Buttons: pp:approve:C-001 / pp:reject:C-001. Text: /edit C-001 make it shorter. Only listed approvers count.\nconst APPROVERS = ['PUT_APPROVER_USERNAME'];\nconst q = $json.callback_query; const m = $json.message;\nif (q && String(q.data).startsWith('pp:')) { const [, action, id] = q.data.split(':');\n  return [{ json: { kind: 'button', action, content_id: id, user: q.from.username || '', allowed: APPROVERS.includes(q.from.username), query_id: q.id, chat_id: q.message.chat.id, message_id: q.message.message_id, original: q.message.text } }]; }\nconst e = String(m?.text || '').match(/^\\/edit(?:@\\w+)?\\s+(C-\\d+)\\s+([\\s\\S]{5,})/i);\nif (e) return [{ json: { kind: 'edit', action: 'edit', content_id: e[1].toUpperCase(), feedback: e[2].trim(), user: m.from.username || '', allowed: APPROVERS.includes(m.from.username), chat_id: m.chat.id, message_id: m.message_id } }];\nreturn [];"
      },
