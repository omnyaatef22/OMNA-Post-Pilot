    {
      "parameters": {
        "jsCode": "// One item per (post, platform) that is due and not yet published there. Re-runs never double-post.\nconst now = $now.setZone('Africa/Cairo').toFormat('yyyy-MM-dd HH:mm'); const out = [];\nfor (const { json: c } of $input.all()) {\n  if (!c.content_id || !c.scheduled_at || c.scheduled_at > now) continue;\n  for (const p of String(c.platforms).split(',').map(s => s.trim())) {\n    if (p === 'facebook' && !c.fb_post_id) out.push({ json: { platform: p, content_id: c.content_id, text: c.fb_text, topic: c.topic } });\n    if (p === 'linkedin' && !c.li_post_id) out.push({ json: { platform: p, content_id: c.content_id, text: c.li_text, topic: c.topic } });\n  }\n}\nreturn out;"
      },
