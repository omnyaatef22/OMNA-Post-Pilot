    {
      "parameters": {
        "jsCode": "const rows = $('Facebook Posts Only').all().map((i, k) => ({ id: i.json.content_id, topic: i.json.topic, s: $('Get Facebook Stats').all()[k]?.json || {} }));\nif (!rows.length) return [];\nconst score = r => (r.s.reactions?.summary?.total_count || 0) + 2 * (r.s.comments?.summary?.total_count || 0) + 3 * (r.s.shares?.count || 0);\nrows.sort((a, b) => score(b) - score(a));\nreturn [{ json: { text: '📈 Engagement today\\n' + rows.slice(0, 10).map(r => '• ' + r.id + ' · ' + String(r.topic).slice(0, 40) + ' · ❤️ ' + (r.s.reactions?.summary?.total_count || 0) + ' 💬 ' + (r.s.comments?.summary?.total_count || 0) + ' 🔁 ' + (r.s.shares?.count || 0)).join('\\n') } }];"
      },
