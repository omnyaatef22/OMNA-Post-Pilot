lue":"YOUR_ID","mode":"id"},"sheetName":{"__rl":true,"value":802,"mode":"id","cachedResultName":"Rules"},"options":{}},"id":"n453","name":"Read Rules","type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[220,0],"executeOnce":true,"retryOnFail":true,"maxTries":3,"waitBetweenTries":2000},{"parameters":{"authentication":"oAuth2","resource":"sheet","operation":"read","documentId":{"__rl":true,"value":"YOUR_ID","mode":"id"},"sheetName":{"__rl":true,"value":801,"mode":"id","cachedResultName":"Content"},"options":{}},"id":"n454","name":"Read Content Queue","type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[440,0],"executeOnce":true,"alwaysOutputData":true,"retryOnFail":true,"maxTries":3,"waitBetweenTries":2000},{"parameters":{"jsCode":"// New topics and topics sent back with feedback. Check the brief before spending an AI call.\nconst now = $now.setZone('Africa/Cairo').toFormat('yyyy-MM-dd HH:mm');\nconst out = [];\nfor (const { json: c } of $input.all()) {\n  if (!c.content_id || !['new', 'revise'].includes(c.status)) continue;\n  const p = []; const plats = String(c.platforms || '').split(',').map(s => s.trim()).filter(Boolean);\n  if (!plats.length || plats.some(x => !['facebook', 'linkedin'].includes(x))) p.push('platforms must be facebook and/or linkedin');\n  if (!['en', 'ar'].includes(c.language)) p.push('language must be en or ar');\n  if (!/^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$/.test(c.scheduled_at || '') || c.scheduled_at <= now) p.push('scheduled_at must be a future \"YYYY-MM-DD HH:mm\"');\n  if (String(c.topic || '').length < 10) p.push('topic too short');\n  if (Number(c.revisions || 0) >= 3) p.push('3 drafts rejected: a human should write this one');\n  out.push({ json: { ...c, plats, brief_problems: p } });\n}\nreturn out;"},"id":"n455","name":"Pick Topics to Draft","type":"n8n-nodes-base.code","typeVersion":2,"position":[660,0]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":3},"conditions":[{"id":"c456","leftValue":"={{ $json.brief_problems.length }}","rightValue":0,"operator":{"type":"number","operation":"equals"}}],"combinator":"and"},"looseTypeValidation":true,"options":{}},"id":"n457","name":"Brief OK?","type":"n8n-nodes-base.if","typeVersion":2.3,"position":[880,0]},{"parameters":{"jsCode":"const rules = $('Read Rules').all().map(i => i.json); const tags = rules.filter(r => r.type === 'required_hashtag').map(r => r.value);\nconst banned = rules.filter(r => r.type === 'banned').map(r => r.value);\nreturn $input.all().map(({ json: c }) => ({ json: { ...c, prompt: 'Write social media posts for an Egyptian education/automation brand. Topic: ' + c.topic + '. Language: ' + (c.language === 'ar' ? 'Egyptian Arabic' : 'English') +\n  '. Platforms: ' + c.plats.join(', ') + '. Facebook: friendly, max 900 characters, 1 question to the audience. LinkedIn: professional, max 1300 characters, 3 short paragraphs. Include ' + tags.join(' ') + '. Never use: ' + banned.join(', ') +\n  (c.feedback ? '. The previous draft was rejected with this feedback, fix it: ' + c.feedback : '') + '. Return JSON only: {\"facebook\": \"\", \"linkedin\": \"\"} (empty string for platforms not requested).' } }));"},"id":"n458","name":"Prepare Draft Prompt","type":"n8n-nodes-base.code","typeVersion":2,"position":[1100,-100]},{"parameters":{"method":"POST","url":"https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent","authentication":"predefinedCredentialType","nodeCredentialType":"googlePalmApi","sendBody":true,"specifyBody":"json","jsonBody":"={{ JSON.stringify({ contents: [{ parts: [{ text: $json.prompt }].concat($json.b64 ? [{ inline_data: { mime_type: $json.mime, data: $json.b64 } }] : []) }], generationConfig: { responseMimeType: 'application/json', temperature: 0.1 } }) }}","options":{"timeout":60000}},"id":"n459","name":"AI Draft Posts","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1320,-100],"retryOnFail":true,"maxTries":3,"waitBetweenTries":2000},{"parameters":{"jsCode":"// Platform limits, banned words and required hashtags are rules, not suggestions.\nconst rules = $('Read Rules').all().map(i => i.json); const val = t => rules.filter(r => r.type === t).map(r => r.value);\nconst lim = { facebook: Number(val('fb_max_chars')[0] || 2000), linkedin: Number(val('li_max_chars')[0] || 3000) };\nreturn $input.all().map((it, k) => {\n  const c = $('Prepare Draft Prompt').all()[k].json; let d; const p = [];\n  try { d = JSON.parse((it.json.candidates?.[0]?.content?.parts || []).map(x => x.text).join('')); } catch (e) { d = {}; p.push('AI returned invalid JSON'); }\n  const out = {};\n  for (const pl of c.plats) {\n    let t = String(d[pl] || '').trim(); if (!t) { p.push(pl + ' draft empty'); continue; }\n    for (const tag of val('required_hashtag')) if (!t.includes(tag)) t += ' ' + tag;\n    for (const b of val('banned')) if (t.toLowerCase().includes(b.toLowerCase())) p.push(pl + ' uses banned phrase \"' + b + '\"');\n    if (t.length > lim[pl]) p.push(pl + ' is ' + t.length + ' characters (max ' + lim[pl] + ')');\n    out[pl] = t;\n  }\n  return { json: { ...c, prompt: undefined, fb_text: out.facebook || '', li_text: out.linkedin || '', draft_problems: p, revisions: Number(c.revisions || 0) + 1 } };\n});"},"id":"n460","name":"Check Drafts","type":"n8n-nodes-base.code","typeVersion":2,"position":[1540,-100]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose","version":3},"conditions":[{"id":"c461","leftValue":"={{ $json.draft_problems.length }}","rightValue":0,"operator":{"type":"number","operation":"equals"}}],"combinator":"and"},"looseTypeValidation":true,"options":{}},"id":"n462","name":"Drafts OK?","type":"n8n-nodes-base.if","typeVersion":2.3,"position":[1760,-100]},{"parameters":{"authentication":"oAuth2","resource":"sheet","operation":"update","documentId":{"__rl":true,"value":"YOUR_ID","mode":"id"},"sheetName"