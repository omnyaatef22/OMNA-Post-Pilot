e,"type":"string","canBeUsedToMatch":true,"removed":false}],"attemptToConvertTypes":false,"convertFieldsToString":true},"options":{"cellFormat":"RAW"}},"id":"n467","name":"Mark Brief Problem","type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[1100,120],"retryOnFail":true,"maxTries":3,"waitBetweenTries":2000},{"parameters":{"chatId":"YOUR_CHAT_ID","text":"={{ '✋ ' + $('Pick Topics to Draft').item.json.content_id + ' needs attention: ' + $('Pick Topics to Draft').item.json.brief_problems.join('; ') }}","additionalFields":{"appendAttribution":false}},"id":"n468","name":"Tell Team: Needs a Human","type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[1320,120],"onError":"continueRegularOutput"},{"parameters":{"updates":["message","callback_query"],"additionalFields":{}},"id":"n469","name":"Telegram Trigger","type":"n8n-nodes-base.telegramTrigger","typeVersion":1.3,"position":[0,500]},{"parameters":{"jsCode":"// Buttons: pp:approve:C-001 / pp:reject:C-001. Text: /edit C-001 make it shorter. Only listed approvers count.\nconst APPROVERS = ['PUT_APPROVER_USERNAME'];\nconst q = $json.callback_query; const m = $json.message;\nif (q && String(q.data).startsWith('pp:')) { const [, action, id] = q.data.split(':');\n  return [{ json: { kind: 'button', action, content_id: id, user: q.from.username || '', allowed: APPROVERS.includes(q.from.username), query_id: q.id, chat_id: q.message.chat.id, message_id: q.message.message_id, original: q.message.text } }]; }\nconst e = String(m?.text || '').match(/^\\/edit(?:@\\w+)?\\s+(C-\\d+)\\s+([\\s\\S]{5,})/i);\nif (e) return [{ json: { kind: 'edit', action: 'edit', content_id: e[1].toUpperCase(), feedback: e[2].trim(), user: m.from.username || '', allowed: APPROVERS.includes(m.from.username), chat_id: m.chat.id, message_id: m.message_id } }];\nreturn [];"},"id":"n470","name":"Parse Approval","type":"n8n-nodes-base.code","typeVersion":2,"position":[220,500]},{"parameters":{"authentication":"oAuth2","resource":"sheet",