t_id + ' your feedback' }}","additionalFields":{"appendAttribution":false},"replyMarkup":"inlineKeyboard","inlineKeyboard":{"rows":[{"row":{"buttons":[{"text":"✅ Approve","additionalFields":{"callback_data":"={{ 'pp:approve:' + $('Check Drafts').item.json.content_id }}"}},{"text":"❌ Reject","additionalFields":{"callback_data":"={{ 'pp:reject:' + $('Check Drafts').item.json.content_id }}"}}]}}]}},"id":"n464","name":"Send for Approval","type":"n8n-nodes-base.telegram","typeVersion":1.2,"position":[2200,-200],"retryOnFail":true,"maxTries":3,"waitBetweenTries":2000},{"parameters":{"authentication":"oAuth2","resource":"sheet","operation":"update","documentId":{"__rl":true,"value":"YOUR_ID","mode":"id"},"sheetName":{"__rl":true,"value":801,"mode":"id","cachedResultName":"Content"},"columns":{"mappingMode":"defineBelow","value":{"content_id":"={{ $('Check Drafts').item.json.content_id }}","approval_message_id":"={{ $json.result.message_id }}"},"matchingColumns":["content_id"],"schema":[{"id":"content_id","displayName":"content_id","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false},{"id":"approval_message_id","displayName":"approval_message_id","required":false,"defaultMatch":false,"display":true,"type":"string","canBeUsedToMatch":true,"removed":false}],"attemptToConvertTypes":false,"convertFieldsToString":true},"options":{"cellFormat":"RAW"}},"id":"n465","name":"Save Approval Message","type":"n8n-nodes-base.googleSheets","typeVersion":4.7,"position":[2420,-200],"retryOnFail":true,"maxTries":3,"waitBetweenTries":2000},{"parameters":{"authentication":"oAuth2","resource":"sheet","operation":"update","documentId":{"__rl":true,"value":"YOUR_ID","mode":"id"},"sheetName":{"__rl":true,"value":801,"mode":"id","cachedResultName":"Content"},"columns":{"mappingMode":"defineBelow","value":{"content_id":"={{ $json.content_id }}","status":"={{ $json.revisions >= 3 ? 'needs_human' : 'revise' }}","feedback":"={{ $json.draft_problem